# 统一换行符为 LF，避免 Windows 上提交的 CRLF 破坏 shebang
# （bin/web-render.js 首行是 #!/usr/bin/env node，CRLF 会让 Linux/macOS 报 bad interpreter）
* text=auto eol=lf

# 二进制文件不做换行转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.zip binary
*.pdf binary
*.woff binary
*.woff2 binary

# Windows 批处理保留 CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
